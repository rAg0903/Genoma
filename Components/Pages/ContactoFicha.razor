@page "/contactos/novo"
@page "/contactos/{Id}"

<div class="genoma-page-header genoma-page-header--back">
    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Class="genoma-back-btn" OnClick="Voltar" title="Voltar" />
    <div>
        <h1 class="genoma-page-title">@(IsNovo ? "Novo Contacto" : paciente.Nome)</h1>
        @if (!IsNovo)
        {
            <p class="genoma-page-subtitle">Ficha de contacto</p>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@erro</MudAlert>
}

@if (carregando)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" panel-class="pa-4">
        <MudTabPanel Text="Identificação" Icon="@Icons.Material.Filled.Person">
            <MudGrid>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="paciente.Nome" Label="Nome *" Required="true" /></MudItem>
                <MudItem xs="12" md="6"><MudDatePicker @bind-Date="dataNascimento" Label="Data de Nascimento" /></MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect @bind-Value="paciente.Genero" Label="Género" Clearable="true">
                        <MudSelectItem Value="@("F")">Feminino</MudSelectItem>
                        <MudSelectItem Value="@("M")">Masculino</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.Nif" Label="NIF" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.BiCc" Label="BI / CC" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.SistemaSaude" Label="Sistema de saúde" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="paciente.Telemovel" Label="Telemóvel" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="paciente.TelefoneFixo" Label="Telefone fixo" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="paciente.Email" Label="Email" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="paciente.Morada" Label="Morada" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="paciente.Morada2" Label="Morada (linha 2)" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.CodigoPostal" Label="Código postal" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.Localidade" Label="Localidade" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.Distrito" Label="Distrito" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="paciente.Pais" Label="País" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField @bind-Value="paciente.Altura" Label="Altura (cm)" Min="0" /></MudItem>
                <MudItem xs="12" md="3"><MudNumericField @bind-Value="paciente.Peso" Label="Peso (kg)" Min="0" /></MudItem>
                @if (!IsNovo)
                {
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Registado em @paciente.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        @if (!IsNovo)
        {
            <MudTabPanel Text="Processos" Icon="@Icons.Material.Filled.Assignment">
                <MudStack Row="true" Class="mb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                               Href="@($"/processos/novo?pacienteId={paciente.Id}")">
                        Novo processo
                    </MudButton>
                </MudStack>
                @if (!processosDoContacto.Any())
                {
                    <MudAlert Severity="Severity.Info">Este contacto ainda não tem processos clínicos.</MudAlert>
                }
                else
                {
                    <MudTable Items="@processosDoContacto" Hover="true" Dense="true"
                              RowClass="genoma-row-clickable" T="Processo"
                              OnRowClick="AbrirProcessoContacto">
                        <HeaderContent>
                            <MudTh>N.º Processo</MudTh>
                            <MudTh>Teste</MudTh>
                            <MudTh>Data entrada</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.NumeroProcesso</MudTd>
                            <MudTd>@(context.Teste?.Nome ?? "—")</MudTd>
                            <MudTd>@context.DataEntrada.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>
                                @if (context.Anulado)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Anulado</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Activo</MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Color="Color.Primary" Size="Size.Small"
                                               title="Abrir ficha processo" Href="@($"/processos/{context.Id}")" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        }
    </MudTabs>

    <div class="genoma-form-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar" Disabled="aGuardar">
            @(aGuardar ? "A guardar..." : "Guardar contacto")
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Voltar">Cancelar</MudButton>
    </div>
}

@code {
    [Parameter] public string? Id { get; set; }

    [Inject] private GenomaContext DB { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private Paciente paciente = new();
    private List<Processo> processosDoContacto = new();
    private DateTime? dataNascimento = DateTime.Today.AddYears(-30);
    private string? erro;
    private bool carregando = true, aGuardar;
    private bool IsNovo => string.IsNullOrEmpty(Id);

    protected override async Task OnInitializedAsync()
    {
        if (IsNovo) { paciente = new Paciente { Ativo = true }; carregando = false; return; }
        await Carregar();
    }

    private async Task Carregar()
    {
        carregando = true; erro = null;
        try
        {
            paciente = await DB.Pacientes.AsNoTracking().FirstOrDefaultAsync(p => p.Id == Id && p.Ativo)
                ?? throw new InvalidOperationException("Contacto não encontrado.");
            dataNascimento = paciente.DataNascimento;
            processosDoContacto = await DB.Processos.AsNoTracking()
                .Include(p => p.Teste)
                .Where(p => p.PacienteId == Id && p.Ativo)
                .OrderByDescending(p => p.DataEntrada)
                .ToListAsync();
        }
        catch (Exception ex) { erro = ex.Message; }
        finally { carregando = false; }
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(paciente.Nome))
        {
            Snackbar.Add("O nome é obrigatório.", Severity.Warning);
            return;
        }
        aGuardar = true; erro = null;
        try
        {
            paciente.DataNascimento = dataNascimento ?? DateTime.Today;
            if (IsNovo)
            {
                paciente.Id = Guid.NewGuid().ToString();
                paciente.CreatedAt = DateTime.Now;
                DB.Pacientes.Add(paciente);
            }
            else
            {
                var ex = await DB.Pacientes.FindAsync(paciente.Id)
                    ?? throw new InvalidOperationException("Contacto não encontrado.");
                ex.Nome = paciente.Nome; ex.DataNascimento = paciente.DataNascimento;
                ex.Genero = paciente.Genero; ex.Nif = paciente.Nif; ex.BiCc = paciente.BiCc;
                ex.SistemaSaude = paciente.SistemaSaude; ex.Telemovel = paciente.Telemovel;
                ex.TelefoneFixo = paciente.TelefoneFixo; ex.Email = paciente.Email;
                ex.Morada = paciente.Morada; ex.Morada2 = paciente.Morada2;
                ex.CodigoPostal = paciente.CodigoPostal; ex.Localidade = paciente.Localidade;
                ex.Distrito = paciente.Distrito; ex.Pais = paciente.Pais;
                ex.Altura = paciente.Altura; ex.Peso = paciente.Peso;
            }
            await DB.SaveChangesAsync();
            Snackbar.Add("Contacto guardado.", Severity.Success);
            Nav.NavigateTo(IsNovo ? $"/contactos/{paciente.Id}" : "/contactos");
        }
        catch (Exception ex) { erro = ex.Message; }
        finally { aGuardar = false; }
    }

    private void AbrirProcessoContacto(TableRowClickEventArgs<Processo> args)
    {
        if (args.Item is null) return;
        Nav.NavigateTo("/processos/" + args.Item.Id);
    }

    private void Voltar() => Nav.NavigateTo("/contactos");
}
