@page "/faturacao"

<div class="genoma-page-header">
    <div>
        <h1 class="genoma-page-title">Faturação</h1>
        <p class="genoma-page-subtitle">Gestão de faturas e pagamentos</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@erro</MudAlert>
}

<MudGrid Class="genoma-stat-grid mb-4" Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Total Registos</div>
            <div class="genoma-stat-value">@totalRegistos</div>
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Pendentes</div>
            <div class="genoma-stat-value warning">@pendentes</div>
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Faturadas</div>
            <div class="genoma-stat-value success">@faturadas</div>
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Total Faturado</div>
            <div class="genoma-stat-value">@totalFaturado.ToString("N2") €</div>
        </div>
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Class="genoma-panel">
    <div class="genoma-toolbar mb-4">
        <MudTextField @bind-Value="pesquisa"
                      Placeholder="Pesquisar por paciente, processo ou n.º fatura..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnKeyUp="Filtrar"
                      Class="genoma-toolbar-search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
        <MudToggleGroup T="string" Value="filtroEstado" ValueChanged="OnFiltroChanged" Color="Color.Primary" CheckMark="true">
            <MudToggleItem Value="@("todas")">Todas</MudToggleItem>
            <MudToggleItem Value="@("pendentes")">Pendentes</MudToggleItem>
            <MudToggleItem Value="@("faturadas")">Faturadas</MudToggleItem>
        </MudToggleGroup>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Download"
                   OnClick="ExportarCsv">
            Exportar CSV
        </MudButton>
    </div>

    <MudTable Items="@faturasFiltradas" Hover="true" Striped="true" Loading="@carregando"
              RowClass="genoma-row-clickable" T="Facturacao"
              OnRowClick="AbrirFatura">
        <HeaderContent>
            <MudTh>Processo</MudTh>
            <MudTh>Paciente</MudTh>
            <MudTh>Preço (€)</MudTh>
            <MudTh>Valor factura</MudTh>
            <MudTh>Pago</MudTh>
            <MudTh>N.º Fatura</MudTh>
            <MudTh>Data Fatura</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Processo?.NumeroProcesso</MudTd>
            <MudTd>@context.Processo?.Paciente?.Nome</MudTd>
            <MudTd>@context.PrecoTeste.ToString("N2")</MudTd>
            <MudTd>@(context.ValorFactura?.ToString("N2") ?? "—")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.Pago ? Color.Success : Color.Default)">
                    @(context.Pago ? "Sim" : "Não")
                </MudChip>
            </MudTd>
            <MudTd>@(context.NumeroFatura ?? "—")</MudTd>
            <MudTd>@(context.DataFatura?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.NumeroFatura == null ? Color.Warning : Color.Success)">
                    @(context.NumeroFatura == null ? "Pendente" : "Faturada")
                </MudChip>
            </MudTd>
            <MudTd Class="genoma-actions-cell">
                <MudIconButton Icon="@Icons.Material.Outlined.Receipt" title="Ver fatura"
                               Color="Color.Default" Size="Size.Small"
                               OnClick="@(() => AbrirDocumento(context))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" title="Editar fatura"
                               Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => AbrirEdicao(context))" />
                @if (context.ProcessoId != null)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Assignment" title="Ficha processo"
                                   Color="Color.Default" Size="Size.Small"
                                   Href="@($"/processos/{context.ProcessoId}")" />
                }
                @if (context.Processo?.PacienteId != null)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Person"
                                   title="Ver contacto"
                                   Color="Color.Default" Size="Size.Small"
                                   Href="@($"/contactos/{context.Processo.PacienteId}")" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum registo de faturação encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudDialog @bind-Visible="dialogoAberto" Options="dialogoOpcoes">
    <TitleContent>
        <MudText Typo="Typo.h6">@(abaDialogoIndex == 0 ? "Documento de Faturação" : "Editar Faturação")</MudText>
    </TitleContent>
    <DialogContent>
        @if (faturaEditar != null)
        {
            <MudTabs @bind-ActivePanelIndex="abaDialogoIndex" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Documento" Icon="@Icons.Material.Outlined.Receipt">
                    <div class="pt-3">
                    <div class="genoma-fatura-dialog-actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Print"
                                   OnClick="ImprimirFatura">
                            Imprimir / PDF
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Edit"
                                   OnClick="@(() => abaDialogoIndex = 1)">
                            Editar dados
                        </MudButton>
                    </div>
                    <div class="genoma-fatura-dialog-preview">
                        <FaturaDocumento Fatura="faturaEditar" Emitente="empresaEmitente" ElementId="genoma-fatura-doc" />
                    </div>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Editar" Icon="@Icons.Material.Outlined.Edit">
                    <div class="pt-3">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Value="@faturaEditar.Processo?.NumeroProcesso" Label="Processo" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Value="@faturaEditar.Processo?.Paciente?.Nome" Label="Paciente" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="faturaEditar.PrecoTeste" Label="Preço teste (€)" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="faturaEditar.ValorFactura" Label="Valor factura (€)" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="faturaEditar.NumeroFatura" Label="N.º Fatura" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="dataFaturaEditar" Label="Data fatura" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="faturaEditar.EntidadeMultibanco" Label="Entidade MB" MaxLength="5" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="faturaEditar.ReferenciaMultibanco" Label="Referência MB" MaxLength="9" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="faturaEditar.Pago" Label="Pago" Color="Color.Success" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="faturaEditar.NaoGeraComissao" Label="Não gera comissão" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="faturaEditar.Comissao" Label="Comissão" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="dataEnvioEmailEditar" Label="Data envio email" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker @bind-Date="dataEnvioSmsEditar" Label="Data envio SMS" />
                        </MudItem>
                    </MudGrid>
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="FecharDialogo">Fechar</MudButton>
        @if (abaDialogoIndex == 1)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarFatura">Guardar</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [Inject] private GenomaContext DB { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private CsvExportService Csv { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<Facturacao> todas = new();
    private List<Facturacao> faturasFiltradas = new();
    private Facturacao? faturaEditar;
    private Empresa? empresaEmitente;
    private DateTime? dataFaturaEditar, dataEnvioEmailEditar, dataEnvioSmsEditar;

    private string pesquisa = string.Empty;
    private string filtroEstado = "todas";
    private string? erro;
    private bool carregando = true;
    private bool dialogoAberto;
    private int abaDialogoIndex;

    private int totalRegistos;
    private int pendentes;
    private int faturadas;
    private decimal totalFaturado;

    private DialogOptions dialogoOpcoes = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        empresaEmitente = await DB.Empresas.AsNoTracking()
            .Where(e => e.Ativo)
            .OrderBy(e => e.Nome)
            .FirstOrDefaultAsync();
        await Carregar();
    }

    private async Task Carregar()
    {
        carregando = true;
        erro = null;
        try
        {
            todas = await DB.Facturacao
                .AsNoTracking()
                .Include(f => f.Processo!)
                    .ThenInclude(p => p.Paciente)
                .Include(f => f.Processo!)
                    .ThenInclude(p => p.Teste)
                .Where(f => f.Processo!.Ativo)
                .OrderByDescending(f => f.CreatedAt)
                .ToListAsync();

            totalRegistos = todas.Count;
            pendentes = todas.Count(f => f.NumeroFatura == null);
            faturadas = todas.Count(f => f.NumeroFatura != null);
            totalFaturado = todas.Where(f => f.NumeroFatura != null).Sum(f => f.PrecoTeste);

            AplicarFiltros();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            carregando = false;
        }
    }

    private void Filtrar() => AplicarFiltros();

    private void OnFiltroChanged(string value)
    {
        filtroEstado = value;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var query = todas.AsEnumerable();

        query = filtroEstado switch
        {
            "pendentes" => query.Where(f => f.NumeroFatura == null),
            "faturadas" => query.Where(f => f.NumeroFatura != null),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(pesquisa))
        {
            query = query.Where(f =>
                (f.NumeroFatura?.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.Processo?.NumeroProcesso.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.Processo?.Paciente?.Nome.Contains(pesquisa, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        faturasFiltradas = query.ToList();
    }

    private Task ExportarCsv() =>
        Csv.ExportAsync(CsvExportService.NomeFicheiro("faturacao"), CsvExportRows.Faturacao(faturasFiltradas));

    private void AbrirFatura(TableRowClickEventArgs<Facturacao> args)
    {
        if (args.Item is null) return;
        AbrirDocumento(args.Item);
    }

    private void AbrirDocumento(Facturacao fatura)
    {
        PrepararFaturaEdicao(fatura);
        abaDialogoIndex = 0;
        dialogoAberto = true;
    }

    private void AbrirEdicao(Facturacao fatura)
    {
        PrepararFaturaEdicao(fatura);
        abaDialogoIndex = 1;
        dialogoAberto = true;
    }

    private void PrepararFaturaEdicao(Facturacao fatura)
    {
        faturaEditar = new Facturacao
        {
            Id = fatura.Id,
            ProcessoId = fatura.ProcessoId,
            PrecoTeste = fatura.PrecoTeste,
            ValorFactura = fatura.ValorFactura,
            NumeroFatura = fatura.NumeroFatura,
            DataFatura = fatura.DataFatura,
            EntidadeMultibanco = fatura.EntidadeMultibanco,
            ReferenciaMultibanco = fatura.ReferenciaMultibanco,
            Comissao = fatura.Comissao,
            NaoGeraComissao = fatura.NaoGeraComissao,
            Pago = fatura.Pago,
            DataEnvioEmail = fatura.DataEnvioEmail,
            DataEnvioSms = fatura.DataEnvioSms,
            Processo = fatura.Processo
        };
        dataFaturaEditar = fatura.DataFatura;
        dataEnvioEmailEditar = fatura.DataEnvioEmail;
        dataEnvioSmsEditar = fatura.DataEnvioSms;
    }

    private async Task ImprimirFatura()
    {
        try
        {
            await JS.InvokeVoidAsync("genoma.printElement", "genoma-fatura-doc");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Não foi possível imprimir: {ex.Message}", Severity.Warning);
        }
    }

    private void FecharDialogo()
    {
        dialogoAberto = false;
        faturaEditar = null;
    }

    private async Task GuardarFatura()
    {
        if (faturaEditar == null) return;

        try
        {
            var existente = await DB.Facturacao.FindAsync(faturaEditar.Id);
            if (existente == null) return;

            existente.PrecoTeste = faturaEditar.PrecoTeste;
            existente.ValorFactura = faturaEditar.ValorFactura;
            existente.NumeroFatura = faturaEditar.NumeroFatura;
            existente.DataFatura = dataFaturaEditar;
            existente.EntidadeMultibanco = faturaEditar.EntidadeMultibanco;
            existente.ReferenciaMultibanco = faturaEditar.ReferenciaMultibanco;
            existente.Comissao = faturaEditar.Comissao;
            existente.NaoGeraComissao = faturaEditar.NaoGeraComissao;
            existente.Pago = faturaEditar.Pago;
            existente.DataEnvioEmail = dataEnvioEmailEditar;
            existente.DataEnvioSms = dataEnvioSmsEditar;
            existente.UpdatedAt = DateTime.Now;

            await DB.SaveChangesAsync();
            Snackbar.Add("Faturação atualizada.", Severity.Success);
            FecharDialogo();
            await Carregar();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
