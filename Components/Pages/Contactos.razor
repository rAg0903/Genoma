@page "/contactos"

<div class="genoma-page-header">
    <div>
        <h1 class="genoma-page-title">Contactos</h1>
        <p class="genoma-page-subtitle">Gestão de pacientes e clientes</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
        @erro
        <MudText Typo="Typo.caption" Class="mt-2">
            Confirma que o MariaDB está a correr e que a base de dados genoma_db existe.
        </MudText>
    </MudAlert>
}

<MudGrid Class="genoma-stat-grid mb-4" Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Total</div>
            <div class="genoma-stat-value">@totalContactos</div>
        </div>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <div class="genoma-stat-card">
            <div class="genoma-stat-label">Novos este mês</div>
            <div class="genoma-stat-value">@novosEsteMes</div>
        </div>
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Class="genoma-panel">
    <div class="genoma-toolbar mb-4">
        <MudTextField @bind-Value="pesquisa"
                      Placeholder="Pesquisar por nome, NIF ou email..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnKeyUp="FiltrarContactos"
                      Class="genoma-toolbar-search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.Download"
                   OnClick="ExportarCsv">
            Exportar CSV
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NovoContacto">
            Novo Contacto
        </MudButton>
    </div>

    <MudTable Items="@contactosFiltrados" Hover="true" Striped="true" Loading="@carregando"
              RowClass="genoma-row-clickable" T="Paciente"
              OnRowClick="AbrirContacto">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Data Nascimento</MudTh>
            <MudTh>NIF</MudTh>
            <MudTh>Telemóvel</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Criado em</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nome</MudTd>
            <MudTd>@context.DataNascimento.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Nif</MudTd>
            <MudTd>@context.Telemovel</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
            <MudTd Class="genoma-actions-cell">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Color="Color.Primary" Size="Size.Small"
                               title="Editar"
                               OnClick="@(() => EditarContacto(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Color="Color.Error" Size="Size.Small"
                               title="Eliminar"
                               OnClick="@(() => EliminarContacto(context.Id))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum contacto encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Inject] private GenomaContext DB { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private CsvExportService Csv { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private List<Paciente> todosContactos = new();
    private List<Paciente> contactosFiltrados = new();
    private string pesquisa = string.Empty;
    private string? erro;
    private bool carregando = true;
    private int totalContactos;
    private int novosEsteMes;

    protected override async Task OnInitializedAsync()
    {
        await CarregarContactos();
    }

    private async Task CarregarContactos()
    {
        carregando = true;
        erro = null;

        try
        {
            todosContactos = await DB.Pacientes
                .AsNoTracking()
                .Where(p => p.Ativo)
                .OrderBy(p => p.Nome)
                .ToListAsync();

            contactosFiltrados = todosContactos;
            totalContactos = todosContactos.Count;
            novosEsteMes = todosContactos.Count(p =>
                p.CreatedAt.Month == DateTime.Now.Month &&
                p.CreatedAt.Year == DateTime.Now.Year);
        }
        catch (Exception ex)
        {
            erro = $"Erro ao carregar contactos: {ex.Message}";
            todosContactos = new();
            contactosFiltrados = new();
            totalContactos = 0;
            novosEsteMes = 0;
        }
        finally
        {
            carregando = false;
        }

        AplicarPesquisaQuery();
    }

    protected override void OnParametersSet() => AplicarPesquisaQuery();

    private void AplicarPesquisaQuery()
    {
        if (string.IsNullOrWhiteSpace(Q))
            return;

        pesquisa = Q;
        if (todosContactos.Count > 0)
            FiltrarContactos();
    }

    private void FiltrarContactos()
    {
        if (string.IsNullOrWhiteSpace(pesquisa))
            contactosFiltrados = todosContactos;
        else
            contactosFiltrados = todosContactos
                .Where(p => p.Nome.Contains(pesquisa, StringComparison.OrdinalIgnoreCase)
                         || (p.Nif != null && p.Nif.Contains(pesquisa))
                         || (p.Email != null && p.Email.Contains(pesquisa, StringComparison.OrdinalIgnoreCase)))
                .ToList();
    }

    private void AbrirContacto(TableRowClickEventArgs<Paciente> args) =>
        Nav.NavigateTo("/contactos/" + args.Item.Id);

    private void NovoContacto() => Nav.NavigateTo("/contactos/novo");
    private void EditarContacto(string id) => Nav.NavigateTo($"/contactos/{id}");

    private Task ExportarCsv() =>
        Csv.ExportAsync(CsvExportService.NomeFicheiro("contactos"), CsvExportRows.Contactos(contactosFiltrados));

    private async Task EliminarContacto(string id)
    {
        try
        {
            var paciente = await DB.Pacientes.FindAsync(id);
            if (paciente != null)
            {
                paciente.Ativo = false;
                await DB.SaveChangesAsync();
                await CarregarContactos();
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao eliminar contacto: {ex.Message}";
        }
    }
}
