@page "/contactos"

<MudText Typo="Typo.h4" Class="mb-2">Contactos</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">
    Gestão de pacientes e clientes
</MudText>

@if (!string.IsNullOrEmpty(erro))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">
        @erro
        <MudText Typo="Typo.caption" Class="mt-2">
            Confirma que o MariaDB está a correr e que a base de dados genoma_db existe.
        </MudText>
    </MudAlert>
}

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total</MudText>
            <MudText Typo="Typo.h5">@totalContactos</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Novos este mês</MudText>
            <MudText Typo="Typo.h5">@novosEsteMes</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="2" Class="pa-4">
    <MudStack Row="true" Class="mb-4" AlignItems="AlignItems.Center">
        <MudTextField @bind-Value="pesquisa"
                      Placeholder="Pesquisar por nome, NIF ou email..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      OnKeyUp="FiltrarContactos"
                      Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NovoContacto">
            Novo Contacto
        </MudButton>
    </MudStack>

    <MudTable Items="@contactosFiltrados" Hover="true" Striped="true" Loading="@carregando">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Data Nascimento</MudTh>
            <MudTh>NIF</MudTh>
            <MudTh>Telemóvel</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Criado em</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Nome</MudTd>
            <MudTd>@context.DataNascimento.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Nif</MudTd>
            <MudTd>@context.Telemovel</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>@context.CreatedAt.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => EditarContacto(context.Id))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => EliminarContacto(context.Id))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Nenhum contacto encontrado.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Inject] private GenomaContext DB { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private List<Paciente> todosContactos = new();
    private List<Paciente> contactosFiltrados = new();
    private string pesquisa = string.Empty;
    private string? erro;
    private bool carregando = true;
    private int totalContactos;
    private int novosEsteMes;

    protected override async Task OnInitializedAsync()
    {
        await CarregarContactos();
    }

    private async Task CarregarContactos()
    {
        carregando = true;
        erro = null;

        try
        {
            todosContactos = await DB.Pacientes
                .AsNoTracking()
                .Where(p => p.Ativo)
                .OrderBy(p => p.Nome)
                .ToListAsync();

            contactosFiltrados = todosContactos;
            totalContactos = todosContactos.Count;
            novosEsteMes = todosContactos.Count(p =>
                p.CreatedAt.Month == DateTime.Now.Month &&
                p.CreatedAt.Year == DateTime.Now.Year);
        }
        catch (Exception ex)
        {
            erro = $"Erro ao carregar contactos: {ex.Message}";
            todosContactos = new();
            contactosFiltrados = new();
            totalContactos = 0;
            novosEsteMes = 0;
        }
        finally
        {
            carregando = false;
        }
    }

    private void FiltrarContactos()
    {
        if (string.IsNullOrWhiteSpace(pesquisa))
            contactosFiltrados = todosContactos;
        else
            contactosFiltrados = todosContactos
                .Where(p => p.Nome.Contains(pesquisa, StringComparison.OrdinalIgnoreCase)
                         || (p.Nif != null && p.Nif.Contains(pesquisa))
                         || (p.Email != null && p.Email.Contains(pesquisa, StringComparison.OrdinalIgnoreCase)))
                .ToList();
    }

    private void NovoContacto() => Nav.NavigateTo("/contactos/novo");
    private void EditarContacto(string id) => Nav.NavigateTo($"/contactos/{id}");

    private async Task EliminarContacto(string id)
    {
        try
        {
            var paciente = await DB.Pacientes.FindAsync(id);
            if (paciente != null)
            {
                paciente.Ativo = false;
                await DB.SaveChangesAsync();
                await CarregarContactos();
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao eliminar contacto: {ex.Message}";
        }
    }
}
