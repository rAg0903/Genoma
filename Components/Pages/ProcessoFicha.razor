@page "/processos/novo"

<div class="genoma-page-header genoma-page-header--back">
    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Class="genoma-back-btn" Href="/processos" title="Voltar" />
    <div>
        <h1 class="genoma-page-title">Novo Processo</h1>
        <p class="genoma-page-subtitle">Criar um novo processo clínico</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(erro))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@erro</MudAlert>
}

<MudPaper Elevation="0" Class="genoma-panel">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect @bind-Value="pacienteId" Label="Paciente *" Required="true">
                @foreach (var p in pacientes)
                {
                    <MudSelectItem Value="@p.Id">@p.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="numeroProcesso" Label="N.º Processo" ReadOnly="true" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect Value="testeId" ValueChanged="@((string? id) => OnTesteAlterado(id))" Label="Teste genético" Clearable="true">
                @foreach (var t in testes)
                {
                    <MudSelectItem Value="@t.Id">@t.Nome (@t.Preco.ToString("N2") €)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect @bind-Value="postoId" Label="Posto de colheita" Clearable="true">
                @foreach (var p in postos)
                {
                    <MudSelectItem Value="@p.Id">@p.Nome</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudDatePicker @bind-Date="dataEntrada" Label="Data de Entrada" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudNumericField @bind-Value="precoTeste" Label="Preço (€)" Min="0" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="notas" Label="Notas" Lines="3" />
        </MudItem>
    </MudGrid>

    <div class="genoma-form-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar" Disabled="aGuardar">
            Criar Processo
        </MudButton>
        <MudButton Variant="Variant.Outlined" Href="/processos">Cancelar</MudButton>
    </div>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "pacienteId")]
    public string? PacienteIdQuery { get; set; }

    [Inject] private GenomaContext DB { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private List<Paciente> pacientes = new();
    private List<Teste> testes = new();
    private List<Posto> postos = new();
    private string? pacienteId;
    private string? testeId;
    private string? postoId;
    private string numeroProcesso = string.Empty;
    private DateTime? dataEntrada = DateTime.Today;
    private decimal precoTeste;
    private string? notas;
    private string? erro;
    private bool aGuardar;

    protected override async Task OnInitializedAsync()
    {
        pacientes = await DB.Pacientes.AsNoTracking().Where(p => p.Ativo).OrderBy(p => p.Nome).ToListAsync();
        testes = await DB.Testes.AsNoTracking().Where(t => t.Ativo).OrderBy(t => t.Nome).ToListAsync();
        postos = await DB.Postos.AsNoTracking().OrderBy(p => p.Nome).ToListAsync();

        if (!string.IsNullOrEmpty(PacienteIdQuery))
            pacienteId = PacienteIdQuery;

        var count = await DB.Processos.CountAsync() + 1;
        numeroProcesso = $"P{DateTime.Now:yyyyMMdd}-{count:D4}";
    }

    private void OnTesteAlterado(string? id)
    {
        testeId = id;
        var teste = testes.FirstOrDefault(t => t.Id == id);
        if (teste != null)
            precoTeste = teste.Preco;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrEmpty(pacienteId))
        {
            Snackbar.Add("Seleciona um paciente.", Severity.Warning);
            return;
        }

        aGuardar = true;
        erro = null;

        try
        {
            if (!string.IsNullOrEmpty(testeId))
            {
                var (ok, msg) = await StockService.DescontarPorTesteAsync(DB, testeId);
                if (!ok)
                {
                    Snackbar.Add(msg ?? "Stock insuficiente.", Severity.Error);
                    return;
                }
            }

            var processoId = Guid.NewGuid().ToString();
            DB.Processos.Add(new Processo
            {
                Id = processoId,
                NumeroProcesso = numeroProcesso,
                PacienteId = pacienteId,
                TesteId = testeId,
                PostoId = postoId,
                DataEntrada = dataEntrada ?? DateTime.Today,
                Notas = notas,
                Ativo = true
            });
            DB.InformacaoClinica.Add(new InformacaoClinica { Id = Guid.NewGuid().ToString(), ProcessoId = processoId });
            DB.Colheitas.Add(new Colheita { Id = Guid.NewGuid().ToString(), ProcessoId = processoId, PostoId = postoId });
            DB.Facturacao.Add(new Facturacao { Id = Guid.NewGuid().ToString(), ProcessoId = processoId, PrecoTeste = precoTeste });
            DB.ProcessoKits.Add(new ProcessoKit
            {
                Id = Guid.NewGuid().ToString(), ProcessoId = processoId,
                NumeroKit = numeroProcesso, TrackingNumber = numeroProcesso,
                LocalizacaoKit = CromossomaOpcoes.LocalizacoesKit[0]
            });
            DB.ResultadosClinicos.Add(new ResultadoClinico
            {
                Id = Guid.NewGuid().ToString(), ProcessoId = processoId, SemAnomalias = true
            });

            await DB.SaveChangesAsync();
            Snackbar.Add("Processo criado.", Severity.Success);
            Nav.NavigateTo($"/processos/{processoId}");
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            aGuardar = false;
        }
    }
}
