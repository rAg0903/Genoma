{
  "name": "genoma-app",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "migrate": "cd backend && npm run migrate",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:preview": "cd frontend && npm run preview",
    "desktop:install": "cd desktop && npm install",
    "app": "open Genoma.app",
    "desktop:dev": "npm run frontend:build && cd desktop && npm start",
    "desktop:open": "open Genoma.app",
    "desktop:pack:mac": "cd desktop && npm run pack:mac",
    "desktop:pack:win": "cd desktop && npm run pack:win"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
