# Ambiente
NODE_ENV=development

# Servidor
PORT=3000
APP_VERSION=1.0.0

# Base de Dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=berto123
DB_NAME=genoma
DB_CHARSET=utf8mb4

# Segurança
JWT_SECRET=seu_segredo_jwt_muito_secreto_aqui_123456789
JWT_EXPIRE=8h

# Logs (Pino)
LOG_LEVEL=info
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Documentação API (desactivada em produção por defeito)
SWAGGER_ENABLED=true

# Monitorização (opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups
BACKUP_DIR=./database/backups
BACKUP_RETENTION_DAYS=30

# Kit lifecycle
LABORATORIO_DEFAULT_CODIGO=FEATUREHEALTH_UK
KIT_AUTO_DESCARTE_ENABLED=true
KIT_AUTO_DESCARTE_STARTUP_MS=30000

# Rate Limiting
# Em producao: 100 pedidos / 15 min por IP. Em desenvolvimento o rate limit fica desativado.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
