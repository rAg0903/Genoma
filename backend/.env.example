# Ambiente
NODE_ENV=development

# Servidor
PORT=3000

# Base de Dados MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=berto123
DB_NAME=genoma
DB_CHARSET=utf8mb4

# Segurança
JWT_SECRET=seu_segredo_jwt_muito_secreto_aqui_123456789
JWT_EXPIRE=7d

# Logs
LOG_LEVEL=development
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Kit lifecycle — laboratório final default (ex.: FeatureHealth UK)
LABORATORIO_DEFAULT_CODIGO=FEATUREHEALTH_UK

# Rate Limiting
# Em producao: 100 pedidos / 15 min por IP. Em desenvolvimento o rate limit fica desativado.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Environments
IS_PRODUCTION=false
