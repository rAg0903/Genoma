%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#f8fafc', 'primaryTextColor': '#0f172a', 'primaryBorderColor': '#0d9488', 'lineColor': '#64748b', 'fontFamily': 'Segoe UI, Arial, sans-serif'}}}%%
classDiagram
    direction TB

    class Utilizador {
        +UUID id
        +String email
        +String passwordHash
        +UUID perfil_id
        +autenticar()
    }

    class Perfil {
        +UUID id
        +String nome
    }

    class Paciente {
        +UUID id
        +String nome
        +String nif
        +Date data_nascimento
    }

    class Medico {
        +UUID id
        +String num_ordem
    }

    class Teste {
        +UUID id
        +String nome
        +Decimal preco
        +String cromossomas
    }

    class Lote {
        +UUID id
        +String codigo_lote
        +Date validade
        +Int quantidade
    }

    class Kit {
        +UUID id
        +String codigo_barras
        +Enum status
        +Enum localizacao
    }

    class Processo {
        +UUID id
        +String numero_processo
        +String status_id
        +Date data_colheita
        +transitarEstado()
    }

    class Colheita {
        +UUID id
        +Date data_prevista
        +Date data_efetiva
    }

    class ResultadoGenetico {
        +UUID id
        +String cromossoma
        +String resultado_valor
    }

    class Facturacao {
        +UUID id
        +String numero_fatura
        +Decimal valor_final
    }

    class LogAuditoria {
        +UUID id
        +String acao
        +String tabela_afetada
    }

    Perfil "1" --> "*" Utilizador : perfil_id
    Utilizador "1" --> "0..1" Medico : utilizador_id
    Lote "1" --> "*" Kit : lote_id
    Kit "1" --> "0..1" Processo : kit_id
    Paciente "1" --> "*" Processo : paciente_id
    Medico "1" --> "*" Processo : medico_id
    Teste "1" --> "*" Processo : teste_id
    Processo "1" --> "*" ResultadoGenetico
    Processo "1" --> "0..1" Facturacao
    Processo "1" --> "0..*" Colheita
    Utilizador "1" --> "*" LogAuditoria
