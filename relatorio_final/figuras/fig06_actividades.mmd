%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#ecfdf5', 'primaryTextColor': '#134e4a', 'primaryBorderColor': '#0d9488', 'lineColor': '#0f766e', 'fontFamily': 'Segoe UI, Arial, sans-serif'}}}%%
flowchart TD
    Start([Início]) --> A["Processo criado<br/>Estado: Agendado"]
    A --> B{Kit<br/>disponível?}
    B -->|Sim| C["Kit Reservado"]
    B -->|Não| Wait[Aguardar / Reagendar]
    Wait --> B
    C --> D["Colheita Realizada"]
    D --> E["Enviado Laboratório"]
    E --> F["Em Análise"]
    F --> G["Resultado Disponível"]
    G --> H["Validado"]
    H --> I["Faturado"]
    I --> End([Estado terminal])

    A --> Cancel{Cancelar?}
    C --> Cancel
    D --> Cancel
    E --> Cancel
    F --> Cancel
    G --> Cancel
    H --> Cancel
    Cancel -->|Sim| X["Cancelado"]
    X --> EndCancel([Estado terminal])

    style A fill:#ccfbf1,stroke:#0d9488
    style C fill:#ccfbf1,stroke:#0d9488
    style D fill:#ccfbf1,stroke:#0d9488
    style E fill:#ccfbf1,stroke:#0d9488
    style F fill:#99f6e4,stroke:#0d9488
    style G fill:#99f6e4,stroke:#0d9488
    style H fill:#5eead4,stroke:#0d9488
    style I fill:#2dd4bf,stroke:#0d9488,color:#fff
    style X fill:#fecaca,stroke:#dc2626
