sequenceDiagram
    actor Tecnico as Técnico
    participant FE as Frontend<br/>(ProcessPipeline)
    participant API as Backend API
    participant SVC as processos.service
    participant DB as MariaDB

    Tecnico->>FE: Altera estado no Kanban / Drawer
    FE->>API: PUT /api/processos/:id
    API->>SVC: actualizarProcesso()
    SVC->>DB: SELECT processo actual
    SVC->>SVC: assertTransicaoValida(atual, destino)

    alt Transição válida
        SVC->>DB: UPDATE processos + datas contextuais
        SVC->>DB: INSERT logs_auditoria
        DB-->>SVC: processo actualizado
        SVC-->>API: 200 OK
        API-->>FE: JSON processo
        FE-->>Tecnico: UI reflecte novo estado
    else Transição inválida
        SVC-->>API: 400 Bad Request
        API-->>FE: Erro descritivo
        FE-->>Tecnico: Mensagem de erro
    end
